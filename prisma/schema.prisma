generator client {
  provider      = "prisma-client"
  // Arahkan output ke infrastructure (sesuai template service Anda)
  output        = "../src/infrastructures/database/postgresql/generated/prisma"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Tambahkan model notifikasi ini
model Notification {
  id         String    @id @default(cuid())
  userId     String?
  targetRole String?
  title      String
  message    String
  type       String
  channels   String[]  @default(["WEBSOCKET"])
  data       Json?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, isRead])
  @@index([targetRole, isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}
